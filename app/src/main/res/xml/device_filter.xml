<?xml version="1.0" encoding="utf-8"?>
<!--
    USB serial devices that should trigger the app on USB_DEVICE_ATTACHED.
    vendor-id values are DECIMAL. Covers the common USB-serial chipsets used by
    flight controllers and SiK telemetry radios.
-->
<resources>
    <!-- FTDI (0x0403) -->
    <usb-device vendor-id="1027" />
    <!-- Silicon Labs CP210x (0x10C4) -->
    <usb-device vendor-id="4292" />
    <!-- Prolific PL2303 (0x067B) -->
    <usb-device vendor-id="1659" />
    <!-- QinHeng CH340/CH341 (0x1A86) -->
    <usb-device vendor-id="6790" />
    <!-- Arduino (0x2341) -->
    <usb-device vendor-id="9025" />
    <!-- STMicroelectronics — many Pixhawk/Cube CDC ACM (0x0483) -->
    <usb-device vendor-id="1155" />
    <!-- 3D Robotics / mRo (0x26AC) -->
    <usb-device vendor-id="9900" />
    <!-- Hex / ProfiCNC Cube (0x2DAE) -->
    <usb-device vendor-id="11694" />

    <!--
        Skydroid T12 video (USB Video Class / UVC). The T12's actual USB
        vendor/product ID has not been confirmed against hardware, so this
        filters by USB interface class instead (14 = UsbConstants.USB_CLASS_VIDEO,
        matching any standard UVC device). If the T12 does not enumerate under
        this class, it is not a plain UVC camera and this filter (and the UVC
        capture path in videotracking/source/) will not match it — see
        UsbUvcVideoSource's class doc for what that would mean.
    -->
    <usb-device class="14" />
</resources>
